<!DOCTYPE html>
<html lang="tr" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EsnafEli | Doğrudan Esnaftan Komisyonsuz Sipariş Rehberi</title>
    <meta name="description" content="EsnafEli ile mahallenizdeki en iyi restoranların özel menülerine ulaşın, komisyonsuz ve aracısız doğrudan WhatsApp sipariş sayfasından sipariş verin.">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Google Fonts: Inter & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
    
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        display: ['Plus Jakarta Sans', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#fff5f0',
                            100: '#ffe6db',
                            200: '#ffcbb8',
                            500: '#ff5a1f',
                            600: '#e0420b',
                            700: '#b83206',
                        },
                        whatsapp: {
                            500: '#25D366',
                            600: '#1da851',
                        }
                    }
                }
            }
        }
    </script>

    <style>
        /* Özel Kaydırma Çubuğu Gizleme (Kategoriler için) */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
        
        /* Kart Hover Animasyonu */
        .restaurant-card {
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .restaurant-card:hover {
            transform: translateY(-5px);
        }
        
        /* Arka Plan Deseni */
        .hero-pattern {
            background-color: #111827;
            background-image: radial-gradient(at 0% 0%, rgba(255, 90, 31, 0.25) 0px, transparent 50%),
                              radial-gradient(at 100% 100%, rgba(37, 211, 102, 0.15) 0px, transparent 50%);
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased selection:bg-brand-500 selection:text-white flex flex-col min-h-screen">

    <!-- ÜST BİLGİ BANDI -->
    <div class="bg-gradient-to-r from-brand-600 via-brand-500 to-amber-500 text-white text-xs sm:text-sm py-2 px-4 text-center font-medium shadow-sm">
        <div class="max-w-7xl mx-auto flex items-center justify-center gap-2 flex-wrap">
            <span class="bg-white/20 px-2 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider">⚡ %0 Komisyon</span>
            <span>Aracı yok! Restoranı seçin, doğrudan esnafın kendi özel WhatsApp sipariş sayfasına bağlanın.</span>
        </div>
    </div>

    <!-- NAVBAR / ÜST MENÜ -->
    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200/80 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between gap-3">
            
            <!-- Logo -->
            <a href="#" onclick="resetAllFilters(); return false;" class="flex items-center gap-2.5 group">
                <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-2xl bg-gradient-to-br from-brand-500 to-brand-600 flex items-center justify-center text-white shadow-md shadow-brand-500/25 group-hover:scale-105 transition-transform">
                    <i class="fa-solid fa-utensils text-lg sm:text-xl"></i>
                </div>
                <div class="flex flex-col">
                    <div class="flex items-center gap-1">
                        <span class="font-display font-extrabold text-xl sm:text-2xl tracking-tight text-slate-900">Esnaf<span class="text-brand-500">Eli</span></span>
                        <span class="hidden sm:inline-block text-[10px] font-bold bg-emerald-100 text-emerald-700 px-1.5 py-0.5 rounded-md border border-emerald-200">LEZZET</span>
                    </div>
                    <span class="text-[11px] text-slate-500 -mt-1 font-medium">esnafeli.com.tr</span>
                </div>
            </a>

            <!-- Bölge / Mahalle Seçici & Aksiyon Butonları -->
            <div class="flex items-center gap-2 sm:gap-3">
                <!-- Mahalle Seçimi -->
                <div class="relative flex items-center bg-slate-100 hover:bg-slate-200/70 transition-colors rounded-xl px-3 py-2 border border-slate-200/80">
                    <i class="fa-solid fa-location-dot text-brand-500 mr-2 text-sm"></i>
                    <div class="flex flex-col text-left">
                        <span class="text-[10px] text-slate-400 font-semibold leading-none uppercase">Teslimat Bölgesi</span>
                        <select id="districtSelect" onchange="applyFilters()" class="bg-transparent text-xs sm:text-sm font-bold text-slate-800 focus:outline-none cursor-pointer pr-4 mt-0.5">
                            <option value="Tümü">Tüm Bölgeler</option>
                            <option value="Merkez">Merkez Mahallesi</option>
                            <option value="Çarşı">Çarşı & Meydan</option>
                            <option value="Üniversite">Üniversite Kampüs</option>
                            <option value="Yenişehir">Yenişehir Konutları</option>
                            <option value="Sanayi">Sanayi Bölgesi</option>
                        </select>
                    </div>
                </div>

                <!-- Favoriler Butonu -->
                <button onclick="toggleFavoritesFilter()" id="favFilterBtn" class="relative p-2.5 sm:px-3.5 sm:py-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 transition-all flex items-center gap-2 text-sm font-semibold" title="Favori Restoranlarım">
                    <i class="fa-regular fa-heart text-rose-500 text-base" id="favHeaderIcon"></i>
                    <span class="hidden md:inline">Favoriler</span>
                    <span id="favCountBadge" class="hidden bg-rose-500 text-white text-[10px] font-bold px-1.5 py-0.2 rounded-full">0</span>
                </button>

                <!-- Esnaf Başvuru Butonu -->
                <button onclick="openPartnerModal()" class="bg-slate-900 hover:bg-slate-800 text-white text-xs sm:text-sm font-bold px-3.5 py-2.5 sm:px-4 sm:py-2.5 rounded-xl shadow-sm transition-all flex items-center gap-2">
                    <i class="fa-solid fa-store text-brand-500"></i>
                    <span class="hidden sm:inline">Restoran Ekle</span>
                    <span class="sm:hidden">Esnaf Ol</span>
                </button>
            </div>
        </div>
    </header>

    <!-- HERO & ARAMA ALANI -->
    <section class="hero-pattern text-white pt-8 pb-10 sm:py-14 px-4 relative overflow-hidden">
        <div class="max-w-4xl mx-auto text-center relative z-10">
            <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-md border border-white/15 rounded-full px-3.5 py-1.5 text-xs sm:text-sm font-medium text-amber-300 mb-4">
                <i class="fa-brands fa-whatsapp text-whatsapp-500 text-base"></i>
                <span>Doğrudan Restoranın WhatsApp Sipariş Sayfasına Yönlendirme</span>
            </div>
            
            <h1 class="font-display font-extrabold text-2xl sm:text-4xl lg:text-5xl tracking-tight leading-tight mb-3">
                Canın Ne Çekiyorsa Seç,<br class="hidden sm:inline" />
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-500 via-amber-400 to-emerald-400">Direkt Esnafın Sayfasından</span> Sipariş Ver!
            </h1>
            
            <p class="text-slate-300 text-sm sm:text-base max-w-2xl mx-auto mb-6 sm:mb-8 font-normal">
                Üye olmak yok, şifre unutmak yok! Anlaşmalı restoranlarımızı incele, <strong class="text-white">"Menüye Git & Sipariş Ver"</strong> butonuna tıklayarak restoranın özel sipariş ekranına anında geç.
            </p>

            <!-- Arama Çubuğu -->
            <div class="max-w-2xl mx-auto relative">
                <div class="flex items-center bg-white rounded-2xl p-1.5 sm:p-2 shadow-2xl shadow-black/40 border-2 border-transparent focus-within:border-brand-500 transition-all">
                    <div class="pl-3 sm:pl-4 pr-2 text-slate-400">
                        <i class="fa-solid fa-magnifying-glass text-lg"></i>
                    </div>
                    <input 
                        type="text" 
                        id="searchInput" 
                        oninput="applyFilters()"
                        placeholder="Restoran adı, kebap, döner, burger veya tatlı ara..." 
                        class="w-full py-2.5 sm:py-3 px-2 text-slate-800 placeholder-slate-400 text-sm sm:text-base font-medium focus:outline-none bg-transparent"
                    >
                    <button onclick="clearSearch()" id="clearSearchBtn" class="hidden text-slate-400 hover:text-slate-600 px-2">
                        <i class="fa-solid fa-circle-xmark text-lg"></i>
                    </button>
                    <button onclick="applyFilters()" class="bg-brand-500 hover:bg-brand-600 text-white font-bold text-sm sm:text-base px-5 sm:px-7 py-2.5 sm:py-3 rounded-xl transition-colors shrink-0 shadow-md shadow-brand-500/20">
                        Bul
                    </button>
                </div>

                <!-- Hızlı Arama Etiketleri -->
                <div class="flex items-center justify-center gap-2 flex-wrap mt-3 text-xs text-slate-300">
                    <span class="text-slate-400">Popüler:</span>
                    <button onclick="quickSearch('Döner')" class="hover:text-white bg-white/10 hover:bg-white/20 px-2.5 py-1 rounded-lg transition">🌯 Hatay Döner</button>
                    <button onclick="quickSearch('Lahmacun')" class="hover:text-white bg-white/10 hover:bg-white/20 px-2.5 py-1 rounded-lg transition">🍕 Lahmacun & Pide</button>
                    <button onclick="quickSearch('Burger')" class="hover:text-white bg-white/10 hover:bg-white/20 px-2.5 py-1 rounded-lg transition">🍔 Ev Yapımı Burger</button>
                    <button onclick="quickSearch('Çiğ Köfte')" class="hover:text-white bg-white/10 hover:bg-white/20 px-2.5 py-1 rounded-lg transition">🌶️ Çiğ Köfte</button>
                </div>
            </div>
        </div>
    </section>

    <!-- KATEGORİLER & FİLTRE ÇUBUĞU -->
    <section class="bg-white border-b border-slate-200 sticky top-16 sm:top-20 z-30 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
            
            <!-- Kategori Butonları (Yatay Kaydırılabilir) -->
            <div id="categoryContainer" class="flex items-center gap-2 overflow-x-auto no-scrollbar pb-1">
                <!-- JS ile doldurulacak -->
            </div>

            <!-- Alt Filtreler ve Sıralama -->
            <div class="flex flex-wrap items-center justify-between gap-3 pt-3 mt-2 border-t border-slate-100 text-xs sm:text-sm">
                <div class="flex items-center gap-2 sm:gap-3 flex-wrap">
                    <!-- Sadece Açık Olanlar -->
                    <label class="inline-flex items-center gap-2 cursor-pointer bg-slate-100 hover:bg-slate-200/70 px-3 py-1.5 rounded-xl font-medium text-slate-700 transition select-none">
                        <input type="checkbox" id="onlyOpenCheck" onchange="applyFilters()" class="rounded text-brand-500 focus:ring-brand-500 w-4 h-4 accent-brand-500">
                        <span>🟢 Sadece Açık Restoranlar</span>
                    </label>

                    <!-- Kampanyalı / İndirimli -->
                    <label class="inline-flex items-center gap-2 cursor-pointer bg-slate-100 hover:bg-slate-200/70 px-3 py-1.5 rounded-xl font-medium text-slate-700 transition select-none">
                        <input type="checkbox" id="onlyPromoCheck" onchange="applyFilters()" class="rounded text-brand-500 focus:ring-brand-500 w-4 h-4 accent-brand-500">
                        <span>🔥 Özel Kampanyalılar</span>
                    </label>
                </div>

                <!-- Sıralama & Sonuç Sayısı -->
                <div class="flex items-center gap-3 ml-auto">
                    <span id="resultCountText" class="text-slate-500 font-medium hidden sm:inline">0 restoran listeleniyor</span>
                    <div class="flex items-center gap-1.5 bg-slate-100 px-3 py-1.5 rounded-xl border border-slate-200/60">
                        <i class="fa-solid fa-arrow-down-wide-short text-slate-400 text-xs"></i>
                        <select id="sortSelect" onchange="applyFilters()" class="bg-transparent text-slate-700 font-semibold focus:outline-none cursor-pointer text-xs sm:text-sm">
                            <option value="featured">Önerilen Sıralama</option>
                            <option value="rating">En Yüksek Puan</option>
                            <option value="minBasket">En Düşük Min. Tutar</option>
                            <option value="fast">En Hızlı Teslimat</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ANA İÇERİK: RESTORAN LİSTESİ -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-1 w-full">
        
        <!-- Bilgilendirme / Nasıl Çalışır Kartları (Kapatılabilir veya Kompakt) -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3 sm:gap-4 mb-8">
            <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-sm flex items-center gap-3.5">
                <div class="w-11 h-11 rounded-xl bg-orange-100 text-brand-600 flex items-center justify-center shrink-0 font-bold text-lg">
                    1
                </div>
                <div>
                    <h3 class="font-bold text-slate-900 text-sm">Restoranını Seç</h3>
                    <p class="text-xs text-slate-500 mt-0.5">Mahallendeki anlaşmalı esnafların teslimat süresi ve min. paket tutarını gör.</p>
                </div>
            </div>
            <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-sm flex items-center gap-3.5">
                <div class="w-11 h-11 rounded-xl bg-amber-100 text-amber-600 flex items-center justify-center shrink-0 font-bold text-lg">
                    2
                </div>
                <div>
                    <h3 class="font-bold text-slate-900 text-sm">Özel Sipariş Sayfasına Git</h3>
                    <p class="text-xs text-slate-500 mt-0.5">Butona tıkla; restoran için hazırladığımız özel dijital menü ve sepet ekranı açılsın.</p>
                </div>
            </div>
            <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-sm flex items-center gap-3.5">
                <div class="w-11 h-11 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0 font-bold text-lg">
                    3
                </div>
                <div>
                    <h3 class="font-bold text-slate-900 text-sm">WhatsApp'tan Anında Gönder</h3>
                    <p class="text-xs text-slate-500 mt-0.5">Siparişin tek tıkla doğrudan restoranın WhatsApp hattına düşsün, sıcak sıcak gelsin!</p>
                </div>
            </div>
        </div>

        <!-- Başlık -->
        <div class="flex items-center justify-between mb-5">
            <div>
                <h2 id="activeCategoryTitle" class="font-display font-extrabold text-xl sm:text-2xl text-slate-900">
                    Tüm Anlaşmalı Restoranlar
                </h2>
                <p class="text-xs sm:text-sm text-slate-500 mt-0.5">Sipariş vermek istediğiniz restoranın kartına tıklayarak özel sipariş sayfasına gidebilirsiniz.</p>
            </div>
        </div>

        <!-- RESTORAN KARTLARI GRİD -->
        <div id="restaurantGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
            <!-- JS ile restoran kartları buraya yüklenecek -->
        </div>

        <!-- Sonuç Bulunamadı Durumu -->
        <div id="emptyState" class="hidden bg-white rounded-3xl border border-slate-200 p-10 text-center max-w-md mx-auto my-8 shadow-sm">
            <div class="w-16 h-16 bg-slate-100 text-slate-400 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl">
                <i class="fa-solid fa-plate-wheat"></i>
            </div>
            <h3 class="font-display font-bold text-lg text-slate-800 mb-1">Aradığınız Kriterde Restoran Bulunamadı</h3>
            <p class="text-sm text-slate-500 mb-5">Farklı bir kategori seçebilir veya arama filtrelerini sıfırlayarak tüm esnaflarımızı görebilirsiniz.</p>
            <button onclick="resetAllFilters()" class="bg-brand-500 hover:bg-brand-600 text-white font-bold text-sm px-5 py-2.5 rounded-xl transition shadow">
                Tüm Restoranları Göster
            </button>
        </div>

        <!-- ESNAF / RESTORAN BAŞVURU BANNER -->
        <div class="mt-14 bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 rounded-3xl p-6 sm:p-10 text-white shadow-xl relative overflow-hidden border border-slate-700">
            <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-brand-500/20 rounded-full blur-3xl pointer-events-none"></div>
            <div class="relative z-10 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
                <div class="max-w-2xl">
                    <span class="inline-block bg-brand-500 text-white text-xs font-extrabold px-3 py-1 rounded-full uppercase tracking-wider mb-3">
                        Restoran & Esnaf İş Ortaklığı
                    </span>
                    <h3 class="font-display font-extrabold text-2xl sm:text-3xl mb-2">
                        Restoranınızı <span class="text-brand-500">EsnafEli</span>'ye Ekleyin, Komisyon Ödemeyin!
                    </h3>
                    <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
                        Yüksek yemek platformu komisyonlarından sıkıldınız mı? Size özel hazırlayacağımız akıllı **WhatsApp Sipariş Sayfası** ile müşterileriniz menünüzden ürünlerini seçsin, adres ve ödeme bilgileriyle birlikte sipariş doğrudan sizin WhatsApp hattınıza düşsün!
                    </p>
                    <div class="flex flex-wrap gap-4 mt-4 text-xs sm:text-sm text-emerald-400 font-semibold">
                        <span><i class="fa-solid fa-circle-check mr-1"></i> %0 Komisyon</span>
                        <span><i class="fa-solid fa-circle-check mr-1"></i> Size Özel Sipariş Linki</span>
                        <span><i class="fa-solid fa-circle-check mr-1"></i> Doğrudan WhatsApp veya IBAN/Nakit Ödeme</span>
                    </div>
                </div>
                <div class="flex flex-col sm:flex-row lg:flex-col gap-3 w-full lg:w-auto shrink-0">
                    <button onclick="openPartnerModal()" class="bg-whatsapp-500 hover:bg-whatsapp-600 text-white font-bold px-6 py-4 rounded-2xl shadow-lg shadow-whatsapp-500/25 transition flex items-center justify-center gap-2.5 text-sm sm:text-base">
                        <i class="fa-brands fa-whatsapp text-xl"></i>
                        <span>Hemen İşletmeni Ekle</span>
                    </button>
                </div>
            </div>
        </div>
    </main>

    <!-- RESTORAN ÖNİZLEME & YÖNLENDİRME MODALI -->
    <div id="previewModal" class="fixed inset-0 z-50 hidden bg-slate-900/70 backdrop-blur-sm flex items-end sm:items-center justify-center p-0 sm:p-4">
        <div class="bg-white w-full sm:max-w-lg rounded-t-3xl sm:rounded-3xl shadow-2xl overflow-hidden animate-fadeIn max-h-[90vh] flex flex-col">
            <!-- Üst Görsel -->
            <div class="relative h-48 sm:h-56 bg-slate-200 shrink-0">
                <img id="modalImg" src="" alt="Restoran" class="w-full h-full object-cover">
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
                <button onclick="closePreviewModal()" class="absolute top-4 right-4 w-9 h-9 rounded-full bg-black/50 hover:bg-black/80 text-white flex items-center justify-center transition">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
                <div class="absolute bottom-4 left-5 right-5 text-white">
                    <div class="flex items-center gap-2 mb-1">
                        <span id="modalStatusBadge" class="text-[11px] font-bold px-2 py-0.5 rounded-md"></span>
                        <span id="modalDistrict" class="text-xs bg-white/20 backdrop-blur-sm px-2.5 py-0.5 rounded-md font-medium"></span>
                    </div>
                    <h3 id="modalTitle" class="font-display font-extrabold text-2xl leading-tight"></h3>
                </div>
            </div>

            <!-- Modal İçerik -->
            <div class="p-5 sm:p-6 overflow-y-auto space-y-4">
                <!-- İstatistikler -->
                <div class="grid grid-cols-3 gap-2 bg-slate-50 p-3 rounded-2xl border border-slate-200/80 text-center">
                    <div>
                        <span class="text-[11px] text-slate-400 block font-medium">Puan</span>
                        <span id="modalRating" class="font-bold text-sm text-amber-500"></span>
                    </div>
                    <div class="border-x border-slate-200">
                        <span class="text-[11px] text-slate-400 block font-medium">Teslimat Süresi</span>
                        <span id="modalTime" class="font-bold text-sm text-slate-800"></span>
                    </div>
                    <div>
                        <span class="text-[11px] text-slate-400 block font-medium">Min. Sepet</span>
                        <span id="modalMinBasket" class="font-bold text-sm text-slate-800"></span>
                    </div>
                </div>

                <!-- Açıklama ve Popüler Ürünler -->
                <div>
                    <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">Öne Çıkan Lezzetler & Bilgi</h4>
                    <p id="modalDesc" class="text-sm text-slate-600 leading-relaxed"></p>
                    <div id="modalTags" class="flex flex-wrap gap-1.5 mt-3"></div>
                </div>

                <!-- Bilgilendirme Kutusu -->
                <div class="bg-emerald-50 border border-emerald-200/80 rounded-2xl p-3.5 flex items-start gap-3">
                    <i class="fa-brands fa-whatsapp text-whatsapp-500 text-2xl mt-0.5"></i>
                    <div class="text-xs text-emerald-900 leading-relaxed">
                        <strong>Nasıl Sipariş Verilir?</strong><br>
                        Aşağıdaki <strong>"Sipariş Sayfasına Git"</strong> butonuna bastığınızda bu restoranın özel dijital menüsü açılır. Ürünlerinizi seçip tek tıkla WhatsApp üzerinden siparişinizi tamamlayabilirsiniz.
                    </div>
                </div>

                <!-- Yönlendirme Butonları -->
                <div class="pt-2 flex flex-col gap-2.5">
                    <a id="modalOrderPageBtn" href="#" class="w-full bg-brand-500 hover:bg-brand-600 text-white font-bold py-3.5 px-5 rounded-2xl shadow-lg shadow-brand-500/25 transition flex items-center justify-center gap-2 text-base">
                        <span>Sipariş Sayfasına Git (Özel Menü)</span>
                        <i class="fa-solid fa-arrow-up-right-from-square text-sm"></i>
                    </a>
                    
                    <a id="modalDirectWpBtn" href="#" target="_blank" rel="noopener noreferrer" class="w-full bg-whatsapp-500 hover:bg-whatsapp-600 text-white font-bold py-3 px-5 rounded-2xl transition flex items-center justify-center gap-2 text-sm">
                        <i class="fa-brands fa-whatsapp text-lg"></i>
                        <span>Direkt WhatsApp'tan Yaz</span>
                    </a>
                </div>
