        // Filtreleme ve Sıralama Fonksiyonu
        function applyFilters() {
            const aramaMetni = document.getElementById("searchInput").value.trim().toLowerCase();
            const seciliMahalle = document.getElementById("districtSelect").value;
            const sadeceAcik = document.getElementById("onlyOpenCheck").checked;
            const sadeceKampanya = document.getElementById("onlyPromoCheck").checked;
            const siralama = document.getElementById("sortSelect").value;

            // Temizle butonu görünürlüğü
            const clearBtn = document.getElementById("clearSearchBtn");
            if (aramaMetni.length > 0) {
                clearBtn.classList.remove("hidden");
            } else {
                clearBtn.classList.add("hidden");
            }

            let sonuc = RESTORANLAR.filter(r => {
                // Kategori filtresi
                if (seciliKategori !== "Tümü" && r.kategori !== seciliKategori) return false;
                // Mahalle filtresi
                if (seciliMahalle !== "Tümü" && r.mahalle !== seciliMahalle) return false;
                // Sadece açık olanlar
                if (sadeceAcik && !r.acikMi) return false;
                // Sadece kampanyalılar
                if (sadeceKampanya && (!r.kampanya || r.kampanya.trim() === "")) return false;
                // Favoriler
                if (sadeceFavoriler && !favoriler.includes(r.id)) return false;
                // Arama kutusu
                if (aramaMetni) {
                    const adUyumu = r.ad.toLowerCase().includes(aramaMetni);
                    const katUyumu = r.kategori.toLowerCase().includes(aramaMetni);
                    const mahalleUyumu = r.mahalle.toLowerCase().includes(aramaMetni);
                    const etiketUyumu = r.etiketler.some(e => e.toLowerCase().includes(aramaMetni));
                    if (!adUyumu && !katUyumu && !mahalleUyumu && !etiketUyumu) return false;
                }
                return true;
            });

            // Sıralama (Açık restoranlar her zaman öncelikli)
            sonuc.sort((a, b) => {
                if (a.acikMi !== b.acikMi) return a.acikMi ? -1 : 1;
                if (siralama === "rating") return b.puan - a.puan;
                if (siralama === "minBasket") return a.minSepet - b.minSepet;
                if (siralama === "fast") return a.teslimatDakika - b.teslimatDakika;
                return (b.oneCikan ? 1 : 0) - (a.oneCikan ? 1 : 0);
            });

            // Başlık ve sayaç güncelleme
            const baslikEl = document.getElementById("activeCategoryTitle");
            if (sadeceFavoriler) {
                baslikEl.textContent = "❤️ Favori Restoranlarım";
            } else if (seciliKategori === "Tümü") {
                baslikEl.textContent = seciliMahalle === "Tümü" ? "Tüm Anlaşmalı Restoranlar" : `${seciliMahalle} Bölgesi Restoranları`;
            } else {
                const katObj = KATEGORILER.find(k => k.id === seciliKategori);
                baslikEl.textContent = `${katObj ? katObj.ikon + ' ' + katObj.ad : seciliKategori} Restoranları`;
            }

            document.getElementById("resultCountText").textContent = `${sonuc.length} restoran listeleniyor`;

            renderRestaurants(sonuc);
        }

