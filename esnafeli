            if (r.zorlaKapat) return false;
            if (!r.acilisSaati || !r.kapanisSaati) return true;
            const now = new Date();
            const cur = now.getHours() * 60 + now.getMinutes();
            const [oH, oM] = r.acilisSaati.split(":").map(Number);
            const [cH, cM] = r.kapanisSaati.split(":").map(Number);
            const openM = oH * 60 + oM;
            const closeM = cH * 60 + cM;
            return closeM < openM ? (cur >= openM || cur < closeM) : (cur >= openM && cur < closeM);
        }

