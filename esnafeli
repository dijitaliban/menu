                return;
            }

            const mesaj = `Merhaba EsnafEli! İşletmemi esnafeli.com.tr rehberine eklemek ve özel WhatsApp sipariş sayfası yaptırmak istiyorum.\n\n` +
                          `🏪 *İşletme Adı:* ${restName}\n` +
                          `👤 *Yetkili:* ${ownerName}\n` +
                          `📍 *Bölge/Mahalle:* ${district}\n` +
                          `🍽️ *Kategori:* ${category}\n` +
                          `✅ _KVKK Aydınlatma Metni onaylanmıştır._`;

            const wpUrl = `https://wa.me/${SITE_SAHIBI_WHATSAPP}?text=${encodeURIComponent(mesaj)}`;
            window.open(wpUrl, "_blank", "noopener,noreferrer");
            closePartnerModal();
        }

        window.addEventListener("keydown", (e) => {
            if (e.key === "Escape") {
                closePreviewModal();
                closePartnerModal();
                closeInstallModal();
                closeLegalModal();
            }
            if (e.keyCode == 123 || (e.ctrlKey && e.shiftKey && (e.keyCode == 73 || e.keyCode == 74 || e.keyCode == 67)) || (e.ctrlKey && (e.keyCode == 85 || e.keyCode == 83))) {
                e.preventDefault();
                return false;
            }
        });
    </script>
</body>
</html>
