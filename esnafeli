                                       </span>`
                                    : `<span class="bg-rose-600 text-white text-[11px] font-bold px-2.5 py-1 rounded-lg shadow">
                                         ŞU AN KAPALI
                                       </span>`
                                }
                                ${r.kampanya 
                                    ? `<span class="bg-brand-500 text-white text-[11px] font-bold px-2.5 py-1 rounded-lg shadow">
                                         🔥 ${r.kampanya}
                                       </span>`
                                    : ''
                                }
                            </div>

                            <!-- Sağ Üst Favori Butonu -->
                            <button 
                                onclick="toggleFavorite(event, ${r.id})" 
                                class="absolute top-3 right-3 w-9 h-9 rounded-full bg-white/90 hover:bg-white text-rose-500 flex items-center justify-center shadow-md transition transform active:scale-90"
                                title="Favorilere Ekle"
                            >
                                <i class="${isFav ? 'fa-solid' : 'fa-regular'} fa-heart text-base"></i>
                            </button>

                            <!-- Görsel Alt Bilgi: Puan ve Mahalle -->
                            <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between text-white">
                                <span class="text-xs font-semibold bg-black/50 backdrop-blur-md px-2.5 py-1 rounded-lg border border-white/15">
                                    <i class="fa-solid fa-location-dot text-brand-500 mr-1"></i>${r.mahalle}
                                </span>
                                <div class="flex items-center gap-1 bg-amber-400 text-slate-950 font-extrabold text-xs px-2.5 py-1 rounded-lg shadow">
                                    <i class="fa-solid fa-star text-[11px]"></i>
                                    <span>${r.puan.toFixed(1)}</span>
                                    <span class="font-medium text-[10px] opacity-80">(${r.yorumSayisi})</span>
                                </div>
                            </div>
                        </div>

                        <!-- Kart Gövdesi -->
                        <div class="p-5 flex-1 flex flex-col justify-between">
                            <div>
                                <div class="flex items-start justify-between gap-2 mb-1.5">
                                    <h3 class="font-display font-extrabold text-lg text-slate-900 group-hover:text-brand-600 transition-colors leading-snug">
                                        ${r.ad}
                                    </h3>
                                </div>

                                <p class="text-xs text-slate-500 line-clamp-2 mb-3 leading-relaxed">
                                    ${r.aciklama}
                                </p>

                                <!-- Ürün Etiketleri -->
                                <div class="flex flex-wrap gap-1.5 mb-4">
                                    ${r.etiketler.map(etiket => `
                                        <span class="text-[11px] font-medium bg-slate-100 text-slate-600 px-2.5 py-0.5 rounded-md">
                                            ${etiket}
                                        </span>
                                    `).join("")}
                                </div>
                            </div>

                            <div>
                                <!-- Teslimat Bilgileri Barı -->
                                <div class="flex items-center justify-between text-xs text-slate-600 bg-slate-50 px-3.5 py-2.5 rounded-xl border border-slate-200/70 mb-4">
                                    <div class="flex items-center gap-1.5 font-semibold">
                                        <i class="fa-regular fa-clock text-brand-500"></i>
                                        <span>${r.teslimatSuresi}</span>
                                    </div>
                                    <span class="text-slate-300">|</span>
                                    <div class="flex items-center gap-1.5 font-semibold">
                                        <i class="fa-solid fa-basket-shopping text-amber-500"></i>
                                        <span>Min. ${r.minSepet} ₺</span>
                                    </div>
                                    <span class="text-slate-300">|</span>
                                    <div class="flex items-center gap-1 font-bold text-emerald-600">
                                        <i class="fa-solid fa-motorcycle"></i>
                                        <span>${r.teslimatUcreti}</span>
                                    </div>
                                </div>

                                <!-- Aksiyon Butonları (Doğrudan Sipariş Sayfasına Yönlendirir) -->
                                <div class="flex items-center gap-2">
                                    <a 
                                        href="${r.siparisSayfasiUrl}" 
                                        onclick="handleOrderLinkClick(event, ${r.id})"
                                        class="flex-1 bg-brand-500 hover:bg-brand-600 text-white font-bold text-xs sm:text-sm py-3 px-4 rounded-xl shadow-md shadow-brand-500/20 transition flex items-center justify-center gap-2 text-center"
                                    >
                                        <span>Menüye Git & Sipariş Ver</span>
                                        <i class="fa-solid fa-arrow-right text-xs"></i>
                                    </a>

                                    <a 
                                        href="${wpUrl}" 
                                        target="_blank" 
                                        rel="noopener noreferrer"
                                        onclick="event.stopPropagation();"
                                        class="bg-whatsapp-500 hover:bg-whatsapp-600 text-white p-3 rounded-xl shadow-md shadow-whatsapp-500/20 transition flex items-center justify-center shrink-0"
                                        title="Direkt WhatsApp'tan Sipariş Yaz"
                                    >
                                        <i class="fa-brands fa-whatsapp text-lg"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </article>
                `;
            }).join("");
        }

        // Karta veya Sipariş Butonuna Tıklama Yönetimi
        function handleOrderLinkClick(event, id) {
            event.stopPropagation();
            const r = RESTORANLAR.find(item => item.id === id);
            if (!r) return;

            // Eğer henüz gerçek sayfa linki (# ile başlıyorsa) girilmemişse önizleme modalını aç
            if (r.siparisSayfasiUrl.startsWith("#")) {
                event.preventDefault();
                openPreviewModal(r);
            }
            // Gerçek link girilmişse (örn: /odeme/bayraminyeri.html) doğrudan o sayfaya gider!
        }

        function handleCardClick(id) {
            const r = RESTORANLAR.find(item => item.id === id);
            if (!r) return;
            openPreviewModal(r);
        }

        // Restoran Önizleme Modalı
        function openPreviewModal(r) {
            document.getElementById("modalImg").src = r.gorsel;
            document.getElementById("modalTitle").textContent = r.ad;
            document.getElementById("modalDistrict").innerHTML = `<i class="fa-solid fa-location-dot mr-1"></i>${r.mahalle}`;
            document.getElementById("modalRating").innerHTML = `★ ${r.puan.toFixed(1)} (${r.yorumSayisi})`;
            document.getElementById("modalTime").textContent = r.teslimatSuresi;
            document.getElementById("modalMinBasket").textContent = `${r.minSepet} ₺`;
            document.getElementById("modalDesc").textContent = r.aciklama;

            const statusBadge = document.getElementById("modalStatusBadge");
            if (r.acikMi) {
                statusBadge.textContent = "AÇIK - SİPARİŞ ALIYOR";
                statusBadge.className = "text-[11px] font-bold px-2.5 py-0.5 rounded-md bg-emerald-500 text-white";
            } else {
                statusBadge.textContent = "ŞU AN KAPALI";
                statusBadge.className = "text-[11px] font-bold px-2.5 py-0.5 rounded-md bg-rose-600 text-white";
            }

            document.getElementById("modalTags").innerHTML = r.etiketler.map(e => `
                <span class="text-xs font-semibold bg-slate-100 text-slate-700 px-3 py-1 rounded-lg">${e}</span>
            `).join("");

            const orderBtn = document.getElementById("modalOrderPageBtn");
            orderBtn.href = r.siparisSayfasiUrl;

            const wpMesaj = encodeURIComponent(`Merhaba ${r.ad}, esnafeli.com.tr üzerinden ulaşıyorum. Sipariş vermek istiyorum.`);
            document.getElementById("modalDirectWpBtn").href = `https://wa.me/${r.whatsappNo}?text=${wpMesaj}`;

            document.getElementById("previewModal").classList.remove("hidden");
        }

        function closePreviewModal() {
            document.getElementById("previewModal").classList.add("hidden");
        }

        // Esnaf Başvuru Modalı
        function openPartnerModal() {
            document.getElementById("partnerModal").classList.remove("hidden");
        }

        function closePartnerModal() {
            document.getElementById("partnerModal").classList.add("hidden");
        }

        function sendPartnerForm(event) {
            event.preventDefault();
            const restName = document.getElementById("partnerRestName").value.trim();
            const ownerName = document.getElementById("partnerOwnerName").value.trim();
            const district = document.getElementById("partnerDistrict").value.trim();
            const category = document.getElementById("partnerCategory").value.trim() || "Belirtilmedi";

            const mesaj = `Merhaba EsnafEli! Restoranımı sitemize eklemek ve özel WhatsApp sipariş sayfası yaptırmak istiyorum.\n\n` +
                          `🏪 *İşletme Adı:* ${restName}\n` +
                          `👤 *Yetkili:* ${ownerName}\n` +
                          `📍 *Bölge/Mahalle:* ${district}\n` +
                          `🍽️ *Kategori:* ${category}`;

            const wpUrl = `https://wa.me/${SITE_SAHIBI_WHATSAPP}?text=${encodeURIComponent(mesaj)}`;
            window.open(wpUrl, "_blank");
            closePartnerModal();
        }

        // ESC tuşu ile modalları kapatma
        window.addEventListener("keydown", (e) => {
            if (e.key === "Escape") {
                closePreviewModal();
                closePartnerModal();
            }
        });
    </script>
</body>
</html>
